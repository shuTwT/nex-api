datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified DateTime?
  image         String?
  username      String   @unique
  password      String
  role          String   @default("user")
  credits       Int      @default(1000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  subscriptions Subscription[]
  apiUsage      ApiUsage[]
  accounts      Account[]
  sessions      Session[]
  apiTokens     ApiToken[]
  auditLogs     AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  access_token      String?
  refresh_token     String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}

model ApiCategory {
  id          String @id @default(cuid())
  name        String @unique
  description String
  icon        String?
  apis        Api[]
}

model Api {
  id              String      @id @default(cuid())
  name            String
  alias           String      @unique
  description     String
  endpoint        String      @unique
  method          String
  categoryId      String
  category        ApiCategory @relation(fields: [categoryId], references: [id])
  pricing         Int         @default(0)
  documentation   String?
  preScript       String?
  postScript      String?
  isActive        Boolean     @default(true)
  callCount       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  parameters      ApiParameter[]
  responses       ApiResponse[]
  usageRecords    ApiUsage[]
}

model ApiParameter {
  id          String @id @default(cuid())
  apiId       String
  api         Api    @relation(fields: [apiId], references: [id])
  name        String
  type        String
  required    Boolean
  description String
  defaultValue String?
}

model ApiResponse {
  id          String @id @default(cuid())
  apiId       String
  api         Api    @relation(fields: [apiId], references: [id])
  name        String
  type        String
  description String
}

model ApiUsage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  apiId       String
  api         Api      @relation(fields: [apiId], references: [id])
  credits     Int
  status      String
  createdAt   DateTime @default(now())
}

model SubscriptionPlan {
  id                    String   @id @default(cuid())
  title                 String   @unique
  price                 Float
  totalCredits          Int
  sortOrder             Int      @default(0)
  validityDuration      Int
  validityUnit          String   @default("day")
  creditResetCycle      String   @default("month")
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  subscriptions         Subscription[]
  
  @@index([sortOrder])
  @@index([isActive])
}

model Subscription {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  planId          String?
  plan            SubscriptionPlan? @relation(fields: [planId], references: [id])
  planName        String
  credits         Int
  price           Float
  startDate       DateTime          @default(now())
  endDate         DateTime
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  @@index([userId])
  @@index([planId])
  @@index([isActive])
}

model ApiToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  token       String    @unique
  permissions String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  resource    String
  details     String?
  ipAddress   String?
  userAgent   String?
  level       String   @default("info")
  status      String   @default("success")
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([level])
  @@index([status])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String   @default("general")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([category])
}
