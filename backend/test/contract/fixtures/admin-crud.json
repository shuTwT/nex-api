{
  "name": "admin-crud",
  "route": "/api/apis/:id",
  "method": "PUT",
  "auth": "admin",
  "request": {
    "path": { "id": "api-1" },
    "headers": { "authorization": "Bearer <normalized-admin-token>" },
    "body": { "name": "Updated API", "isActive": true }
  },
  "responses": {
    "happy": {
      "status": 200,
      "mediaType": "application/json",
      "body": {
        "success": true,
        "data": {
          "id": "api-1",
          "name": "Updated API",
          "isActive": true,
          "createdAt": "2020-01-01T00:00:00.000Z",
          "updatedAt": "2020-01-01T00:00:00.000Z"
        }
      }
    },
    "failure": {
      "status": 403,
      "mediaType": "application/json",
      "body": { "success": false, "error": "Forbidden: Admin access required" }
    }
  },
  "normalization": {
    "ids": "api-1",
    "timestamps": "2020-01-01T00:00:00.000Z",
    "secrets": "<normalized-admin-token>"
  }
}
