# Nex API Go backend environment variables.
#
# This file is a template only. The backend reads process environment variables
# through Viper; it does not load .env files automatically. Export these values,
# use your process manager/container env_file support, or start the server with a
# YAML configuration file via: nex-api-server -config /path/to/config.yaml
#
# Payment credentials, provider switches, callback URLs, recharge pricing, and
# Mock payment behavior are stored in the SystemSetting database table and are
# maintained through the system settings API/admin console.

# Application
APP_ENV=development
APP_URL=http://localhost:3000

# HTTP server
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=20s
SERVER_MAX_BODY_BYTES=10485760
SERVER_MAX_HEADER_BYTES=1048576
SERVER_CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=file:./data/dev.db
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=1h

# Redis
# REDIS_URL takes precedence. When it is empty, the backend derives an
# unauthenticated URL from REDIS_HOST, REDIS_PORT, and REDIS_DB. Put credentials
# directly in REDIS_URL when authentication is required.
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Authentication and OAuth
# SESSION_SECRET is required in production. Generate a long random value; never
# commit a real secret to this file.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=nex_session
JWT_SECRET=
NEXTAUTH_SECRET=

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORIZATION_URL=
SSO_TOKEN_URL=
SSO_USER_INFO_URL=
SSO_SCOPE=openid profile email

# Uploads
UPLOAD_DIRECTORY=data/upload/
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp
UPLOAD_CREATE_ON_START=true

# Scheduled statistics synchronization. These values bootstrap the built-in
# stats_sync database job on first startup; later CRUD changes in ScheduledJob
# are the source of truth. CRON_SECRET also protects POST /api/cron/sync-stats.
CRON_ENABLED=false
CRON_SECRET=
CRON_INTERVAL=5m

# Logging: LOG_LEVEL=debug|info|warn|error, LOG_FORMAT=text|json
LOG_LEVEL=info
LOG_FORMAT=text
LOG_ADD_SOURCE=false
