# Public (VITE_) environment variables — exposed to the browser.
# Never put server secrets here.

# API base URL. In development the Vite dev proxy forwards /api to the Go backend,
# so this is typically empty. Set this for production builds that call a remote API.
VITE_API_BASE_URL=

# Public application URL (used for metadata / OAuth redirects).
VITE_APP_URL=http://localhost:3000